% start S

# Basic Query Rules
S[SEM=<(WHQUERY(?vp(?v,?f),?np,?whq(?f)))>, VAR=?v, GAP=?f] -> WHICH-QUERY[SEM=?whq] TOUR-NP[SEM=?np, VAR=?f] TOUR-VP[SEM=?vp, VAR=?v]
S[SEM=<(WHQUERY(?vp(?v,?f,t1),?np,?whq(t1)))>, VAR=?v, GAP=t1] -> TIME-QUERY[SEM=?whq] TOUR-NP[SEM=?np, VAR=?f] TOUR-VP[SEM=?vp, VAR=?v]
S[SEM=<(YESNOQUERY(?vp(?v)))>, VAR=?v, GAP=?g] -> CAN-QUERY LIST-VP[SEM=?vp, VAR=?v]
S[SEM=<(TIMEQUERY(?src,?dest,'2:00HR'))>, VAR=?v, GAP=?g] -> HOW-LONG TRAVEL-VP[SEM=?vp] SOURCE-PP[SEM=?src] DEST-PP[SEM=?dest]
S[SEM=<(LISTQUERY)>, VAR=?v, GAP=?g] -> CAN-QUERY 'list' 'all' 'the' 'tours'

# Count Query Rules
S[SEM=<(COUNTQUERY(?dest))>, VAR=?v, GAP=?g] -> HOW-MANY TOUR-N[SEM=?n] 'are' 'there' DEST-PP[SEM=?dest]
S[SEM=<(COUNTQUERY(?dest))>, VAR=?v, GAP=?g] -> HOW-MANY TOUR-NP[SEM=?np] DEST-PP[SEM=?dest]

# Transportation Query Rules
S[SEM=<(TRANSQUERY('NhaTrang'))>, VAR=?v, GAP=?g] -> 'What' 'mode' 'of' 'transportation' 'is' 'used' 'for' DET DEST-NAME[SEM=<'NhaTrang'>] 'tour'
S[SEM=<(TRANSQUERY('PhuQuoc'))>, VAR=?v, GAP=?g] -> 'What' 'mode' 'of' 'transportation' 'is' 'used' 'for' DET DEST-NAME[SEM=<'PhuQuoc'>] 'tour'
S[SEM=<(TRANSQUERY('DaNang'))>, VAR=?v, GAP=?g] -> 'What' 'mode' 'of' 'transportation' 'is' 'used' 'for' DET DEST-NAME[SEM=<'DaNang'>] 'tour'

# Date Query Rules
S[SEM=<(DATEQUERY('NhaTrang'))>, VAR=?v, GAP=?g] -> 'What' 'are' 'the' 'available' 'days' 'for' 'traveling' 'to' DEST-NAME[SEM=<'NhaTrang'>]
S[SEM=<(DATEQUERY('PhuQuoc'))>, VAR=?v, GAP=?g] -> 'What' 'are' 'the' 'available' 'days' 'for' 'traveling' 'to' DEST-NAME[SEM=<'PhuQuoc'>]
S[SEM=<(DATEQUERY('DaNang'))>, VAR=?v, GAP=?g] -> 'What' 'are' 'the' 'available' 'days' 'for' 'traveling' 'to' DEST-NAME[SEM=<'DaNang'>]

# Tour NP Rules
TOUR-NP[SEM=<?det(?cnp)>,VAR=?v] -> DET[SEM=?det] TOUR-CNP[SEM=?cnp,VAR=?v]
TOUR-NP[SEM=?cnp, VAR=?v] -> TOUR-CNP[SEM=?cnp, VAR=?v]
TOUR-CNP[SEM=<?cnp & ?dest(?v)>, VAR=?v] -> TOUR-CNP[SEM=?cnp,VAR=?v] TOUR-DEST[SEM=?dest]
TOUR-CNP[SEM=<?n(?v)>, VAR=?v] -> TOUR-N[SEM=?n, VAR=?v]
TOUR-N[SEM=<TOUR1>, VAR=<t1>] -> 'tour' | 'tours'

# Time Related Rules
TOUR-TIME[SEM=<TIME(?v,?time,?date)>, VAR=?v] -> TIME-DATE[SEM=?time] | P-TIME[SEM=?p] TIME-DATE[SEM=?time]
TIME-DATE[SEM=<TIME(?v,?time,?date)>, VAR=?v] -> TIME-MOD[SEM=?time, VAR=?v] DATE-MOD[SEM=?date]
TIME-MOD[SEM=<'7AM'>, VAR=<t1>] -> '7' 'AM' | '7AM'
TIME-MOD[SEM=<'8AM'>, VAR=<t1>] -> '8' 'AM' | '8AM'
TIME-MOD[SEM=<'9AM'>, VAR=<t1>] -> '9' 'AM' | '9AM'
TIME-MOD[SEM=<'10AM'>, VAR=<t1>] -> '10' 'AM' | '10AM'
TIME-MOD[SEM=<'12AM'>, VAR=<t1>] -> '12' 'AM' | '12AM'

# Date Rules
DATE-MOD[SEM=<'1/7'>, VAR=<d1>] -> '1/7' | 'July' '1st' | '1' 'July'
DATE-MOD[SEM=<'4/7'>, VAR=<d1>] -> '4/7' | 'July' '4th' | '4' 'July'
DATE-MOD[SEM=<'5/7'>, VAR=<d1>] -> '5/7' | 'July' '5th' | '5' 'July'

# Duration Rules
DURATION-MOD[SEM=<'2:00HR'>, VAR=<d1>] -> '2' 'hours' | '2:00' 'hours' | '2:00HR'
DURATION-MOD[SEM=<'5:00HR'>, VAR=<d1>] -> '5' 'hours' | '5:00' 'hours' | '5:00HR'
DURATION-QUERY[SEM=<\x.DURATION(?src,?dest,x)>] -> HOW-LONG TRAVEL-VP SOURCE-PP[SEM=?src] DEST-PP[SEM=?dest]

# Tour VP and Flight Rules
TOUR-VP[SEM=<\r f t.?v(r,f,TIME(t))>, VAR=?r] -> FLIGHT-V[SEM=?v, VAR=?r]
TOUR-VP[SEM=<\r f.?v(r,f,?time)>, VAR=?r] -> FLIGHT-V[SEM=?v, VAR=?r] FLIGHT-TIME[SEM=?time]
FLIGHT-V[SEM=<\r f t.?v(r,f,t)>, VAR=?r] -> ARRIVE-V[SEM=?v, VAR=?r] | DEPARTURE-V[SEM=?v, VAR=?r]
ARRIVE-V[SEM=<\r f t.ARRIVE1(r,f,t)>, VAR=<a1>] -> 'arrives'| 'arrive'
DEPARTURE-V[SEM=<\r f t.DEPART1(r,f,t)>, VAR=<d1>] -> 'departs' | 'depart'

# City Rules
CITY-NP[SEM=<NAME(?v,?x)>,VAR=?v] -> CITY-NAME[SEM=?x,VAR=?v] CITY-N[SEM=?n]
CITY-NP[SEM=<DET(?x)>,VAR=?v] -> DET[SEM=?det] CITY-N[SEM=?x, VAR=?v]
CITY-N[SEM=<CITY>,VAR=<c1>] -> 'city'
CITY-NAME[SEM=<'HCMC'>,VAR=<hcm1>] -> 'Ho' 'Chi' 'Minh' 'City'

# Destination Rules
DEST-NAME[SEM=<'PhuQuoc'>,VAR=<pq1>] -> 'Phu' 'Quoc' | 'Phu_Quoc'
DEST-NAME[SEM=<'DaNang'>,VAR=<dn1>] -> 'Da' 'Nang' | 'Da_Nang'
DEST-NAME[SEM=<'NhaTrang'>,VAR=<nt1>] -> 'Nha' 'Trang' | 'Nha_Trang'
TOUR-DEST[SEM=<\t.DEST(t,?x)>,VAR=?y] -> 'to' DEST-NAME[SEM=?x,VAR=?y]

# Source and Destination PP Rules
SOURCE-PP[SEM=<\x.SOURCE(x,?city)>] -> 'from' CITY-NAME[SEM=?city]
DEST-PP[SEM=<\x.DEST(x,?city)>] -> 'to' CITY-NAME[SEM=?city]
DEST-PP[SEM=<\x.DEST(x,?city)>] -> 'to' DEST-NAME[SEM=?city]
SOURCE-PP[SEM=<'HCMC'>] -> 'from' CITY-NAME[SEM=<'HCMC'>]
DEST-PP[SEM=<'NhaTrang'>] -> 'to' CITY-NAME[SEM=<'NhaTrang'>]

# Flight Source and Destination Rules
FLIGHT-SOURCE[SEM=<\f.SOURCE(f) (?y,?x)>,VAR=?y] -> 'from' CITY-NP[SEM=?x, VAR=?y]
FLIGHT-DEST[SEM=<\f.DEST(f,?x)>,VAR=?y] -> 'to' CITY-NP[SEM=?x,VAR=?y]
FLIGHT-DEST[SEM=<\f.DEST(f,?x)>,VAR=?y] -> 'for' CITY-NP[SEM=?x,VAR=?y]

# Query Type Rules
TIME-QUERY[SEM=<\x.WH(x,WHAT1)>] -> 'What' 'time' 'does' 
TIME-QUERY[SEM=<\x.WH(x,WHEN1)>] -> 'When' 'does'
WHICH-QUERY[SEM=<\x.WH(x,WHICH1)>] -> 'Which'
HOW-LONG[SEM=<\x.DURATION(x)>] -> 'How' 'long' 'does' 'it' 'take'
HOW-MANY[SEM=<\x.COUNT(x)>] -> 'How' 'many'
WHAT-TRANS[SEM=<\x.TRANSPORT(x)>] -> 'What' 'mode' 'of' 'transportation' 'is' 'used' 'for'
WHAT-DATES[SEM=<\x.DATES(x)>] -> 'What' 'are' 'the' 'available' 'days' 'for' 'traveling' 'to'

# Misc Rules
DET[SEM=<THE>] -> 'the'
DET[SEM=<ALL>] -> 'all' | 'the'
FLIGHT-N[SEM=<FLIGHT1>, VAR=<f1>] -> 'flight' | 'flights'
P-TIME[SEM=<AT>] -> 'at'
P-TIME[SEM=<ON>] -> 'on'
P-TIME[SEM=<IN>] -> 'in'
LIST-VP[SEM=<\r.LIST1(r)>, VAR=?r] -> 'list' DET TOUR-N[SEM=?n, VAR=?r]
CAN-QUERY -> 'can' 'you' | 'Can' 'you'
TRANS-TYPE[SEM=<AIRPLANE>] -> 'airplane' | 'by' 'airplane'
TRANS-TYPE[SEM=<TRAIN>] -> 'train' | 'by' 'train'
TRAVEL-VP[SEM=<\x.TRAVEL(x)>] -> 'to' 'travel'